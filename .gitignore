# --- Python -------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node ---------------------------------------------------------------
node_modules/

# --- Secrets ------------------------------------------------------------
# Nothing in this project needs a credential, and nothing should acquire one
# silently. These patterns exist so that if one ever appears it is not
# committed by accident.
.env
.env.*
!.env.example
*.pem
*.key
*_rsa
*_ed25519
credentials.json
secrets.json

# --- Raw downloads (212 MB) ---------------------------------------------
# Every file here is re-downloadable by its own ingest flow, and each flow
# caches, so a fresh clone rebuilds them with one command per layer. One of
# them (LGD_Subdistricts.geojsonl.7z, 57 MB) would also dominate the repo.
data/raw/

# --- Trained models (176 MB) --------------------------------------------
# Regenerated by the ml/pipelines scripts. price_band_classifier.joblib alone
# is 68 MB, which GitHub warns on and which would make every clone slow for
# no benefit — the metrics that describe these models ARE committed, under
# ml/artifacts, so the registry and the ML tabs still have something to read.
models/
*.joblib

# --- Generated plots ----------------------------------------------------
ml/artifacts/**/*.png
ml/artifacts/**/eda/

# --- Local runtime state ------------------------------------------------
# Guidance values are recorded by a person at runtime; the store is local
# state, not source. It ships empty by design.
data/processed/guidance_values.json

# --- OS / editor --------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
