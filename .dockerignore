# The build context is the repository root, so without this Docker would ship
# 388 MB of raw downloads and trained models to the daemon on every build.

.git/
.github/

# 212 MB of re-downloadable source data — the image needs data/processed, not this.
data/raw/

# 176 MB of trained models. Mounted at runtime or rebuilt; see api.Dockerfile.
models/
*.joblib

# Virtualenvs must never enter the image — they carry host paths.
**/.venv/
**/venv/
**/node_modules/

**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/

# Generated plots and EDA output; regenerated by the pipelines.
ml/artifacts/**/*.png
ml/artifacts/**/eda/

# Review deliverables — not part of the running service.
review1_render/
review1_render_editable/
*.pptx
*.pdf

# Local runtime state.
data/processed/guidance_values.json

.env
.env.*
!.env.example
