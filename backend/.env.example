# Copy to .env and fill in. Never commit .env.

GBA_ENVIRONMENT=development
GBA_DEBUG=true

GBA_DATABASE_URL=postgresql+psycopg://gba:gba@localhost:5432/gba
GBA_REDIS_URL=redis://localhost:6379/0

GBA_CORS_ORIGINS=["http://localhost:3000"]

# Required by the ethical HTTP client. Use a real, monitored address —
# government hosts should be able to reach a human about our traffic.
GBA_CONTACT_EMAIL=you@example.com
GBA_PUBLIC_URL=http://localhost:3000/about

# Hosts with incomplete TLS chains (see docs/01-data-source-audit.md 6.1).
# Per-host only. Every fetch using one is stamped into the provenance row.
GBA_TLS_EXCEPTION_HOSTS=[]

GBA_RATE_LIMIT_PER_MINUTE=60
GBA_DOCUMENT_RETENTION_DAYS=90
